{
  "schema": "ooda/work-order/v1",
  "id": "example-001",
  "project_id": "example-quant-research",
  "objective": "Test one pre-specified lagged hypothesis using point-in-time data before expanding the research scope.",
  "role": "researcher",
  "profile": "quantitative-research",
  "lenses": [
    "scientific",
    "statistical",
    "value-of-information"
  ],
  "claim_level": "discovery",
  "scope": {
    "allowed": [
      "research/**",
      "reports/**",
      "tests/**"
    ],
    "forbidden": [
      "live execution",
      "unapproved production changes"
    ]
  },
  "verification": [
    "point-in-time cutoffs preserved",
    "pre-specified hypothesis evaluated as written",
    "result persisted whether positive or negative"
  ],
  "budget": {
    "max_turns": 6,
    "max_investigation_steps": 8
  },
  "stop_conditions": [
    "current durable state conflicts with task assumptions",
    "required data is not available point-in-time",
    "task requires modifying a protected subsystem",
    "objective materially changes",
    "budget is exhausted",
    "qualification claim would be required to continue"
  ],
  "authority": {
    "may_merge": false,
    "may_promote_model": false,
    "may_modify_live_runtime": false,
    "may_spend_real_money": false
  }
}
