#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

show_help() {
  cat <<'EOF'
OODA — bounded AI work without carrying the whole project in chat

Everyday commands:
  ooda init ...       Adopt/scaffold the current repo for OODA
  ooda doctor [path]  Check a repo or one OODA JSON contract
  ooda mission ...    Create one bounded worker mission
  ooda trace ...      Record the result of a completed/blocked mission
  ooda dashboard      Open the local OODA Control Room

Grok surfaces:
  /ooda-controller    Intake / proposal / portfolio control
  /ooda <mission>     Execute one bounded mission in a worker session

Compatibility:
  ooda work-order ... Same as `ooda mission`
  ooda validate FILE  Deprecated alias; use `ooda doctor FILE`

Run `ooda <command> --help` for command-specific arguments.
EOF
}

cmd="${1:-help}"
case "$cmd" in
  help|-h|--help)
    show_help
    exit 0
    ;;
  mission)
    shift
    set -- work-order "$@"
    ;;
  dashboard)
    shift || true
    MONITOR_DIR="${OODA_CONTROL_ROOM_DIR:-$HOME/repos/agent-ops-monitor}"
    MONITOR_REPO="${OODA_CONTROL_ROOM_REPO:-git@github.com:mldugom/agent-ops-monitor.git}"
    if [ ! -d "$MONITOR_DIR/.git" ]; then
      echo "Control Room not found at $MONITOR_DIR; cloning it now..." >&2
      mkdir -p "$(dirname "$MONITOR_DIR")"
      git clone "$MONITOR_REPO" "$MONITOR_DIR"
    fi
    exec bash "$MONITOR_DIR/scripts/agent-monitor" "$@"
    ;;
esac

PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m ooda.cli "$@"
